# PIN สำหรับเข้าแอป (ตัวเลข 6–8 หลัก แนะนำ) — ใช้เป็นรหัสผ่านเปิดไฟล์ PDF สรุปด้วย
APP_PIN=123456

# URL ของเว็บแอป Apps Script (ลงท้ายด้วย /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# รหัสลับจาก Apps Script (Run ฟังก์ชัน setup หรือ showSecret แล้วดูใน Execution log)
APPS_SCRIPT_SECRET=

# (ไม่บังคับ) AI อ่านยอดเงินจากสลิป — ขอ key ฟรีที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (ไม่บังคับ) เปลี่ยนรุ่นโมเดล ค่าเริ่มต้น gemini-3.8-flash (ถ้าไม่ว่างจะสลับรุ่นสำรองให้เอง)
GEMINI_MODEL=
# (ไม่บังคับ) กุญแจเซ็นคุกกี้ล็อกอิน ถ้าไม่ใส่จะสร้างจาก APPS_SCRIPT_SECRET ให้
# เปลี่ยนค่านี้เมื่อต้องการให้ทุกเครื่องที่ล็อกอินค้างอยู่ถูกล็อกออก (เช่น มือถือหาย)
AUTH_SECRET=
