# URL ของเว็บแอป Apps Script (ลงท้ายด้วย /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# รหัสลับจาก Apps Script (Run ฟังก์ชัน setup หรือ showSecret แล้วดูใน Execution log)
# ห้ามเปลี่ยนหลังมีผู้ใช้แล้ว (ใช้สร้างกุญแจเข้ารหัส PIN ถ้าไม่ได้ตั้ง PIN_KEY)
APPS_SCRIPT_SECRET=
# อีเมลผู้ดูแลระบบ — สมัครด้วยอีเมลนี้จะเป็นผู้ดูแลทันที
ADMIN_EMAIL=you@example.com

# (ไม่บังคับ) คีย์ AI กลางสำหรับคนที่ไม่ได้ใส่คีย์ของตัวเอง — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (ไม่บังคับ) รุ่นโมเดล ค่าเริ่มต้น gemini-3.8-flash (ถ้าไม่ว่างจะสลับรุ่นสำรองให้เอง)
GEMINI_MODEL=
# (ไม่บังคับ) กุญแจเซ็นคุกกี้ล็อกอิน — เปลี่ยนเมื่อต้องการให้ทุกเครื่องถูกล็อกออก
AUTH_SECRET=
# (ไม่บังคับ) กุญแจเข้ารหัส PIN — ถ้าไม่ตั้งจะสร้างจาก APPS_SCRIPT_SECRET
PIN_KEY=
