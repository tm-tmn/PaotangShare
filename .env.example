# URL ของเว็บแอป Apps Script (ลงท้ายด้วย /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# รหัสลับจาก Apps Script (Run ฟังก์ชัน setup หรือ showSecret แล้วดูใน Execution log)
# ห้ามเปลี่ยนหลังมีผู้ใช้แล้ว (ใช้สร้างกุญแจเข้ารหัสรหัสเปิด PDF ถ้าไม่ได้ตั้ง PIN_KEY)
APPS_SCRIPT_SECRET=
# Supabase (Project Settings → API) — ใช้เป็นระบบสมัคร/เข้าสู่ระบบ/ลืมรหัสผ่าน
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
# (ไม่บังคับ) ให้ปุ่มลบบัญชีลบล็อกอินใน Supabase ด้วย — ความลับ ห้ามแชร์
SUPABASE_SERVICE_ROLE_KEY=

# (ไม่บังคับ) คีย์ AI กลางสำหรับคนที่ไม่ได้ใส่คีย์ของตัวเอง — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (ไม่บังคับ) รุ่นโมเดล ค่าเริ่มต้น gemini-3.8-flash (ถ้าไม่ว่างจะสลับรุ่นสำรองให้เอง)
GEMINI_MODEL=
# (ไม่บังคับ) กุญแจเข้ารหัสรหัสเปิด PDF — ถ้าไม่ตั้งจะสร้างจาก APPS_SCRIPT_SECRET
PIN_KEY=
